@page
@model KoltsegvetesWebApp.Pages.KategoriaPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Kategoria</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Kategoria.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Kategoria.Nev" class="control-label"></label>
                <input asp-for="Kategoria.Nev" class="form-control" aria-required="true"/>
                <span asp-validation-for="Kategoria.Nev" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kategoria.Tipus" class="control-label"></label>
                <select asp-for="Kategoria.Tipus" class="form-control">
                    <option value="">-- Válasszon --</option>
                    <option value="Bevétel">Bevétel</option>
                    <option value="Kiadás">Kiadás</option>
                </select>
                <span asp-validation-for="Kategoria.Tipus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
